# Generates a C++ source with the given files as byte arrays (see apps/server/WebAssets.h).
# Usage: cmake -DROOT=<dir> -DFILES=<a|b|...> -DOUTPUT=<file.cpp> -P EmbedAssets.cmake
string(REPLACE "|" ";" FILES "${FILES}")
set(arrays "")
set(entries "")
set(index 0)
foreach(file IN LISTS FILES)
	file(READ "${ROOT}/${file}" hex HEX)
	string(LENGTH "${hex}" length)
	math(EXPR size "${length} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
	string(APPEND arrays "const unsigned char asset${index}[] = {${hex}0};\n")
	string(APPEND entries "\t{ \"/${file}\", asset${index}, ${size} },\n")
	math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/EmbedAssets.cmake, do not edit.
#include \"WebAssets.h\"

namespace
{
${arrays}
const WebAsset assets[] = {
${entries}};
} // namespace

const WebAsset *findWebAsset(const std::string &path)
{
	for (const WebAsset &asset : assets) {
		if (path == asset.m_path) {
			return &asset;
		}
	}
	return nullptr;
}
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
